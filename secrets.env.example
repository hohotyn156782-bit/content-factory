# Скопируй в ~/.config/content-factory/secrets.env и заполни (chmod 600).
# GROQ/TG/VK наследуются из ~/.config/content-engine/secrets.env автоматически — дублировать не нужно.

# ── LLM-провайдеры (каскад с фолбэком; чем больше — тем устойчивее) ──
# Порядок и модели — в llm_providers.json. Активен провайдер, если задан его ключ.
# GROQ_API_KEY=...            # console.groq.com — быстрый, основной (шарится с ботами)
# Несколько аккаунтов одного провайдера — через запятую: KEY=k1,k2,k3 (ротация при 429)
# GEMINI_API_KEY=...          # aistudio.google.com/apikey — лучшее RU, ~1000 RPD/акк (flash-lite)
# NVIDIA_API_KEY=...          # build.nvidia.com — ⭐ ГЛАВНЫЙ ПРИЗ: постоянный free БЕЗ дневного лимита, DeepSeek V3.x (RU ~как Claude), ключ nvapi-, без карты
# CHUTES_API_KEY=...          # chutes.ai — ~500K токенов/день free (Qwen3/Llama), ключ cpk_, без карты (децентрализован)
# CEREBRAS_API_KEY=...        # cloud.cerebras.ai — ~1М токенов/день, очень быстрый, без карты
# OPENROUTER_API_KEY=...      # openrouter.ai/keys — :free-модели (часто 429, overflow); 50 RPD free / 1000 после разового $10
# MISTRAL_API_KEY=...         # console.mistral.ai — free tier (~1 RPM, подстраховка)
# XAI_API_KEY=...             # console.x.ai — Grok (ВЫКЛ в конфиге: $25 сгорают за 30д)
# Perplexity и Claude API — НЕ добавлять: у них НЕТ постоянного дневного free (Perplexity платный + search-модель; Claude — только разовый $5 на 14 дней). Claude держать для платных клиентских задач.

# ── Сток-видео (без него — генеративный градиентный фон) ──
# PEXELS_API_KEY=...          # pexels.com/api/new/ — выдаётся мгновенно бесплатно
# PIXABAY_API_KEY=...         # pixabay.com/api/docs/ — бесплатно, фолбэк

# ── YouTube Shorts (полная автопубликация) ──
# YT_CLIENT_SECRET_FILE=/home/baronpavel/.config/content-factory/client_secret.json
# YT_TOKEN_FILE=/home/baronpavel/.config/content-factory/yt_token.json   # создаётся youtube_auth.py

# ── Instagram Reels (полная автопубликация своего аккаунта) ──
# IG_USER_ID=...              # ID IG Business-аккаунта (Graph API /me/accounts)
# IG_ACCESS_TOKEN=...         # long-lived (60д) — обновлять каждые 50д
# Хостинг видео (обязателен для IG — Meta скачивает файл по публичному URL):
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...
# R2_BUCKET=...
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev   # публичный базовый URL бакета

# ── TikTok (полу-авто: inbox + ручной тап) ──
# TIKTOK_ACCESS_TOKEN=...     # опц.; без него — бандл video.mp4 + caption для ручной загрузки

# ── VK (наследуется из content-engine; переопределить можно так) ──
# VK_VIDEO_TARGETS=-239462120:VK_ACC1_TOKEN,-239390950:VK_ACC2_TOKEN

# ── Отчёты (наследуются из content-engine) ──
# TG_BOT_TOKEN=...
# TG_CHAT_ID=...
